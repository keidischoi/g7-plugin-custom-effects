        "effect": { "type": "string", "expose": true },
        "intensity": { "type": "integer", "expose": true },
        "speed": { "type": "integer", "expose": true },
        "opacity": { "type": "integer", "expose": true },
        "wind": { "type": "integer", "expose": true },
        "color": { "type": "string", "expose": true },
        "mobile_enabled": { "type": "boolean", "expose": true },
        "admin_enabled": { "type": "boolean", "expose": true },
        "respect_reduced_motion": { "type": "boolean", "expose": true }
