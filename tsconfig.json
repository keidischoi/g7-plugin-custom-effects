{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["vitest/globals"]
    },
    "include": [
        "resources/js/**/*.ts",
        "vite.config.ts",
        "vitest.config.ts"
    ]
}
