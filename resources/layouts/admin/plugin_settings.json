                    {
                        "id": "footer_buttons",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "sticky-footer-buttons"
                        },
                        "children": [
                            {
                                "id": "cancel_button",
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "type": "button",
                                    "className": "btn btn-secondary"
                                },
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/plugins"
                                        }
                                    }
                                ],
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:common.cancel"
                                    }
                                ]
                            },
                            {
                                "id": "save_button",
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "type": "button",
                                    "disabled": "{{!_local.hasChanges || _local.isSaving}}",
                                    "className": "btn btn-primary flex-center gap-1.5"
                                },
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "sequence",
                                        "actions": [
                                            {
                                                "handler": "setState",
                                                "params": {
                                                    "target": "local",
                                                    "isSaving": true,
                                                    "errors": null
                                                }
                                            },
                                            {
                                                "handler": "apiCall",
                                                "auth_required": true,
                                                "target": "/api/admin/plugins/{{route.identifier}}/settings",
                                                "params": {
                                                    "method": "PUT",
                                                    "body": "{{_local.form}}"
                                                },
                                                "onSuccess": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "hasChanges": false
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "success",
                                                            "message": "$t:admin.plugins.settings.save_success"
                                                        }
                                                    },
                                                    {
                                                        "handler": "refetchDataSource",
                                                        "params": {
                                                            "dataSourceId": "settings"
                                                        }
                                                    }
                                                ],
                                                "onError": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "errors": "{{error.errors}}"
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "error",
                                                            "message": "{{error.message ?? '$t:admin.plugins.settings.save_error'}}"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ],
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{!_local.isSaving}}",
                                        "text": "$t:common.save"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{_local.isSaving}}",
                                        "text": "$t:common.saving"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "schema": {
        "enabled": {
            "type": "boolean",
            "default": true
        },
        "effect": {
            "type": "enum",
            "options": [
                "leaves",
                "snow",
                "maple_leaves",
                "coins",
                "fireflies",
                "cherry_blossoms",
                "petals",
                "stars",
                "rain",
                "bubbles",
                "confetti",
                "ice_cream",
                "stars_multicolor",
                "poop",
                "alarm_clock",
                "bills",
                "cheese",
                "bouncing_bubbles",
                "hearts",
                "sunflowers"
            ],
            "default": "snow"
        },
        "intensity": {
            "type": "integer",
            "min": 10,
            "max": 200,
            "default": 100
        },
        "speed": {
            "type": "integer",
            "min": 25,
            "max": 300,
            "default": 100
        },
        "opacity": {
            "type": "integer",
            "min": 10,
            "max": 100,
            "default": 75
        },
        "wind": {
            "type": "integer",
            "min": 0,
            "max": 100,
            "default": 0
        },
        "wind_direction": {
            "type": "enum",
            "options": [
                "none",
                "left",
                "right",
                "random"
            ],
            "default": "none"
        },
        "color": {
            "type": "enum",
            "options": [
                "#ffffff",
                "#bae6fd",
                "#f9a8d4",
                "#fde047",
                "#86efac",
                "#c4b5fd",
                "#fb923c",
                "#f87171"
            ],
            "default": "#ffffff"
        },
        "schedule_enabled": {
            "type": "boolean",
            "default": false
        },
        "mobile_enabled": {
            "type": "boolean",
            "default": false
        },
        "admin_enabled": {
            "type": "boolean",
            "default": false
        },
        "respect_reduced_motion": {
            "type": "boolean",
            "default": true
        },
        "schedules": {
            "type": "array",
            "default": []
        }
    },
    "init_actions": [
        {
            "handler": "setState",
