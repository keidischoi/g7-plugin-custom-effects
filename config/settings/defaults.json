    "frontend_schema": {
        "enabled": { "type": "boolean", "expose": true },
        "effect": { "type": "string", "expose": true },
        "intensity": { "type": "integer", "expose": true },
        "speed": { "type": "integer", "expose": true },
        "opacity": { "type": "integer", "expose": true },
        "wind": { "type": "integer", "expose": true },
        "wind_direction": { "type": "string", "expose": true },
        "color": { "type": "string", "expose": true },
        "mobile_enabled": { "type": "boolean", "expose": true },
        "admin_enabled": { "type": "boolean", "expose": true },
        "respect_reduced_motion": { "type": "boolean", "expose": true },
        "schedule_enabled": { "type": "boolean", "expose": true },
        "schedules": { "type": "array", "expose": true },
        "schedule_start_date": { "type": "string", "expose": true },
        "schedule_end_date": { "type": "string", "expose": true },
        "schedule_start_time": { "type": "string", "expose": true },
        "schedule_end_time": { "type": "string", "expose": true },
        "schedule_days": { "type": "string", "expose": true },
